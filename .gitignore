# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Local environments and tooling
.venv/
venv/
env/
.env
.env.*
!.env.example
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Generated audit output; reports may contain personal filesystem paths.
reports/

# Local reversible quarantine; may contain user files and manifests with personal paths.
.beta-quarantine/

# Editor and OS-local files
.idea/
.vscode/
*.swp
*.swo

# Temporary local files
*.tmp
*.temp
